# 复制为 .env 后填入你自己的值；本文件不含任何真实凭据，可安全提交。
# server.js 启动时自动读取项目根目录的 .env（已 gitignore）。

# AI 接口密钥（必填，缺省时 AI 功能关闭，页面仍可用本地解读）
TAROT_API_KEY=

# 上游模型网关（公司内网地址，请向网关运营方索取；仓库不保存默认值）
TAROT_GATEWAY_HOST=
TAROT_GATEWAY_PORT=

# 网关使用的模型标识
TAROT_MODEL=

# 网关自签根证书路径（默认读取项目根目录的 gateway-ca.crt）
# TAROT_GATEWAY_CA=gateway-ca.crt

# 监听端口（默认 8901）
# PORT=8901

# AI 用量账本路径（默认 usage-log.jsonl，已 gitignore）
# TAROT_USAGE_LOG=usage-log.jsonl