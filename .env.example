# 复制本文件为 .env（已 gitignore，不会进版本库），填好下面四项后 npm start。
# 不填也能启动：AI 关闭，页面自动使用本地解读引擎，其余功能完全不受影响。

# 1) AI 接口密钥
TAROT_API_KEY=

# 2) 网关地址（向网关运营方索取）
TAROT_GATEWAY_HOST=
TAROT_GATEWAY_PORT=

# 3) 网关使用的模型标识
TAROT_MODEL=

# 格式示例（占位值，请换成你自己的）：
#   TAROT_API_KEY=sk-xxxxxxxxxxxxxxxx
#   TAROT_GATEWAY_HOST=gateway.example.com
#   TAROT_GATEWAY_PORT=52000
#   TAROT_MODEL=your-model-name

# 网关自签根证书路径（默认读取项目根目录的 gateway-ca.crt）
# TAROT_GATEWAY_CA=gateway-ca.crt

# 本地监听端口（默认 8901）
# PORT=8901

# AI 用量账本路径（默认 usage-log.jsonl，已 gitignore）
# TAROT_USAGE_LOG=usage-log.jsonl