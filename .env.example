# 最小配置：只需要填这一项，其余全部有内置默认值。
# 用法：复制本文件为 .env，填入自己的 Key，然后 npm start。
TAROT_API_KEY=

# 以下三项一般不用改，只有要连别的网关时才取消注释覆盖。
# TAROT_GATEWAY_HOST=
# TAROT_GATEWAY_PORT=
# TAROT_MODEL=

# 网关自签根证书路径（默认读取项目根目录的 gateway-ca.crt）
# TAROT_GATEWAY_CA=gateway-ca.crt

# 本地监听端口（默认 8901）
# PORT=8901

# AI 用量账本路径（默认 usage-log.jsonl，已 gitignore）
# TAROT_USAGE_LOG=usage-log.jsonl